{
  "name": "niletech-breach-detect-recover",
  "version": "1.0.0",
  "description": "Data breach detection & recovery build - Data Privacy project, Group 32",
  "main": "server.js",
  "scripts": {
    "setup": "node --disable-warning=ExperimentalWarning scripts/setup.js",
    "reset-demo": "node --disable-warning=ExperimentalWarning scripts/setup.js --reset",
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "traffic:normal": "node --disable-warning=ExperimentalWarning scripts/normal_traffic.js",
    "attack": "node --disable-warning=ExperimentalWarning scripts/bruteforce.js",
    "attack:spray": "node --disable-warning=ExperimentalWarning scripts/bruteforce.js --spray",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "restore": "node --disable-warning=ExperimentalWarning scripts/restore.js",
    "restore:list": "node --disable-warning=ExperimentalWarning scripts/restore.js --list",
    "tamper": "node --disable-warning=ExperimentalWarning scripts/tamper_backup.js",
    "detect": "python detector/detect.py logs/auth.log"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.6.1",
    "dotenv": "^18.0.10",
